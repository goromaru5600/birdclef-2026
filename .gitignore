# Data (large files - not committed)
data/train_audio/
data/test_soundscapes/*.ogg
data/*.zip

# Model weights
models/*.pt
models/*.onnx
models/*.pth

# Jupyter checkpoints
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Python
__pycache__/
*.pyc
*.pyo
.env

# macOS
.DS_Store

# Kaggle API credentials (never commit)
kaggle.json

# tmp/ heavy artifacts (large binaries, caches, run logs, generated outputs)
tmp/**/*.onnx
tmp/**/*.whl
tmp/**/*.pt
tmp/**/*.pth
tmp/**/*.ipynb
tmp/**/*.csv
tmp/**/*.json
tmp/**/cache/
tmp/**/perch_cache/
tmp/**/output/
tmp/**/*.log
tmp/**/*.safetensors
.python-version
